# Supabase (opcional em desenvolvimento: sem estas variáveis o app roda 100% local,
# com sessão anônima guardada no aparelho).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lembretes por Web Push (funcionalidades 02–06). Gere o par com `npx web-push generate-vapid-keys`.
# A pública vai para o app; a privada e o resto são segredos das Edge Functions:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:... LEMBRETES_SEGREDO=...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# GA4 (opcional). Sem ele, track() só loga no console em desenvolvimento.
NEXT_PUBLIC_GA_ID=
# Funcionalidade 17: página do Evangelho do dia no Verbum (o app soma a UTM). Vazio = sem o card.
NEXT_PUBLIC_VERBUM_URL=

# Edge Function de voz (segredo do Supabase, nunca no cliente): supabase secrets set ANTHROPIC_API_KEY=...
# MODELO_VOZ=claude-haiku-4-5
# Leitura de laudo da galeria (funcionalidade 01); padrão claude-opus-5-5:
# MODELO_LAUDO=claude-opus-5-5

# Scripts de seed (service role, só local/CI)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
